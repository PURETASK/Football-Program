  "relationships":[
    {"from":"ENTITY-ORG","to":"ENTITY-PERSON","cardinality":"1_to_many","name":"roster_and_staff"},{"from":"ENTITY-ORG","to":"ENTITY-PLAY","cardinality":"1_to_many","name":"team_playbook"},{"from":"ENTITY-SCHEME","to":"ENTITY-PLAY","cardinality":"1_to_many","name":"scheme_compatibility"},{"from":"ENTITY-FILM","to":"ENTITY-CLIP","cardinality":"1_to_many","name":"bounded_clips"},{"from":"ENTITY-CLIP","to":"ENTITY-OBS","cardinality":"1_to_many","name":"observations"},{"from":"ENTITY-OBS","to":"ENTITY-SCOUT","cardinality":"many_to_many","name":"scouting_evidence"},{"from":"ENTITY-PLAY","to":"ENTITY-DRILL","cardinality":"many_to_many","name":"teaching_drills"},{"from":"ENTITY-PRACTICE","to":"ENTITY-DRILL","cardinality":"many_to_many","name":"practice_periods"},{"from":"ENTITY-GAMEPLAN","to":"ENTITY-SCOUT","cardinality":"many_to_many","name":"plan_evidence"},{"from":"ENTITY-GAMEPLAN","to":"ENTITY-METRIC","cardinality":"many_to_many","name":"plan_metrics"},{"from":"ENTITY-KNOWLEDGE","to":"ENTITY-DECISION","cardinality":"many_to_many","name":"review_and_approval"}
