  "history_model":{"current_record":"latest revision in canonical_records","historical_record":"append-only revision/audit event","supersession":"new revision references prior record; prior version is retained","deletion":"logical revocation only for canonical records"},
  "migration_strategy":["version schema and contracts","forward migration with explicit compatibility check","backfill provenance and tenant key before activation","run regression/eval suite","record migration audit event","support rollback to prior schema version"],
  "security_and_tenancy":["Every tenant-scoped record carries organization_id","Authorization is checked before read/write","Audit events retain actor, reason, revision, and time","Cross-organization reads require explicit approved scope"],
  "audit_event_fields":["event_id","event_type","collection","record_id","revision","actor","reason","occurred_at"]
