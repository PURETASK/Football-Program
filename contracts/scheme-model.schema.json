{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"NFL FIDOS Compositional Scheme Model",
  "type":"object",
  "required":["id","version","unit","name","components","assignments","constraints","source"],
  "properties":{
    "id":{"type":"string","pattern":"^SCHEME-"},
    "version":{"type":"string"},
    "unit":{"enum":["offense","defense","special_teams"]},
    "name":{"type":"string","minLength":1},
    "components":{"type":"array","minItems":1},
    "assignments":{"type":"array","minItems":1},
    "constraints":{"type":"array"},
    "source":{"type":"object","required":["kind","ref"]}
  }
}
