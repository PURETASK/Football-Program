{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nfl-fidos.local/contracts/source-authorization.schema.json",
  "title": "NFL FIDOS Authorized Source Operation",
  "type": "object",
  "required": ["authorization_id", "organization_id", "source_id", "uri", "license_class", "authorization_ref", "approved_by", "approved_at", "allowed_domains", "external_fetch_allowed"],
  "properties": {
    "authorization_id": {"type": "string", "pattern": "^AUTH-SOURCE-"},
    "organization_id": {"type": "string", "pattern": "^ORG-"},
    "source_id": {"type": "string", "pattern": "^SOURCE-"},
    "uri": {"type": "string", "format": "uri"},
    "license_class": {"enum": ["official_public", "licensed", "team_authorized"]},
    "authorization_ref": {"type": "string", "pattern": "^(LICENSE|DEC|APPROVAL|SOURCE-AUTH)-"},
    "approved_by": {"type": "string", "minLength": 1},
    "approved_at": {"type": "string", "minLength": 1},
    "expires_at": {"type": ["string", "null"]},
    "allowed_domains": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "external_fetch_allowed": {"const": true}
  },
  "additionalProperties": true
}
