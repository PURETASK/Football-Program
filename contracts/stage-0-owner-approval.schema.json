{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"NFL FIDOS Stage 0 Owner Approval",
  "type":"object",
  "required":["id","stage","work_package","gate_id","registry_id","decision","approver","approver_role","approved_at","rationale","evidence_refs","production_implementation_allowed"],
  "properties":{
    "id":{"type":"string","pattern":"^APPROVAL-STAGE0-"},
    "stage":{"const":"STAGE-0"},
    "work_package":{"const":"STAGE-0A"},
    "gate_id":{"type":"string","pattern":"^STAGE0-EXIT-"},
    "registry_id":{"type":"string"},
    "decision":{"const":"approved"},
    "approver":{"type":"string","minLength":1},
    "approver_role":{"const":"program_owner"},
    "approved_at":{"type":"string","format":"date-time"},
    "rationale":{"type":"string","minLength":1},
    "evidence_refs":{"type":"array","minItems":1},
    "production_implementation_allowed":{"const":false},
    "stage_advance_authorized":{"const":false}
  },
  "additionalProperties":true
}
