{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nfl-fidos.local/contracts/stage-25-spec-acceptance.schema.json",
  "title": "NFL FIDOS Stage 25 Specification Acceptance Evidence",
  "type": "object",
  "required": ["id", "stage", "spec_id", "decision", "approver", "approver_role", "accepted_at", "rationale", "evidence_refs", "production_implementation_allowed", "stage_advance_authorized"],
  "properties": {
    "id": {"type": "string", "pattern": "^ACCEPTANCE-STAGE25-"},
    "stage": {"const": "STAGE-25"},
    "spec_id": {"type": "string", "pattern": "^MASTER-CODEX-BUILD-SPEC-"},
    "decision": {"const": "accepted"},
    "approver": {"type": "string", "minLength": 1},
    "approver_role": {"const": "program_owner"},
    "accepted_at": {"type": "string", "format": "date-time"},
    "rationale": {"type": "string", "minLength": 1},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "production_implementation_allowed": {"const": false},
    "stage_advance_authorized": {"const": false}
  },
  "additionalProperties": true
}
