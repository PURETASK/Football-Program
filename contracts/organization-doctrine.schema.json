{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nfl-fidos.local/contracts/organization-doctrine.schema.json",
  "title": "NFL FIDOS Organization Football Doctrine Package",
  "type": "object",
  "required": ["id", "organization_id", "team_context", "season", "source_refs", "entries", "status", "human_review_required"],
  "properties": {
    "id": {"type": "string", "pattern": "^ORG-DOCTRINE-"},
    "organization_id": {"type": "string", "pattern": "^ORG-"},
    "team_context": {"type": "string", "minLength": 1},
    "season": {"type": "string", "minLength": 1},
    "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "entries": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "status": {"enum": ["under_review", "validated", "rejected"]},
    "human_review_required": {"type": "boolean"},
    "approved_by": {"type": ["string", "null"]},
    "owner_decision_ref": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
