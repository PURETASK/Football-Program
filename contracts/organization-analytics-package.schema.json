{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nfl-fidos.local/contracts/organization-analytics-package.schema.json",
  "title": "NFL FIDOS Organization Analytics Package",
  "type": "object",
  "required": ["id", "organization_id", "season", "source_refs", "observations", "reports", "status", "human_review_required"],
  "properties": {
    "id": {"type": "string", "pattern": "^ORG-ANALYTICS-"},
    "organization_id": {"type": "string", "pattern": "^ORG-"},
    "season": {"type": "string", "minLength": 1},
    "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "observations": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "reports": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "status": {"enum": ["under_review", "validated", "rejected"]},
    "human_review_required": {"type": "boolean"},
    "approved_by": {"type": ["string", "null"]},
    "owner_decision_ref": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
