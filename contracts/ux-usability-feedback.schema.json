{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nfl-fidos.local/contracts/ux-usability-feedback.schema.json",
  "title": "NFL FIDOS Role-Based Usability Feedback",
  "type": "object",
  "required": ["feedback_id", "organization_id", "session_id", "user_role", "screen_id", "task_id", "outcome", "severity", "feedback_text", "submitted_at", "evidence_refs"],
  "properties": {
    "feedback_id": {"type": "string", "pattern": "^UX-FEEDBACK-"},
    "organization_id": {"type": "string", "pattern": "^ORG-"},
    "session_id": {"type": "string", "pattern": "^UX-SESSION-"},
    "user_role": {"enum": ["player", "coach_staff", "analyst", "program_owner", "validator", "performance_staff"]},
    "screen_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "outcome": {"enum": ["completed", "partially_completed", "blocked"]},
    "severity": {"enum": ["note", "minor", "major", "critical"]},
    "feedback_text": {"type": "string", "minLength": 1},
    "accessibility_issue": {"type": "boolean"},
    "submitted_at": {"type": "string", "format": "date-time"},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "disposition": {"enum": ["new", "under_review", "accepted", "rejected"]}
  },
  "additionalProperties": true
}
