{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"NFL FIDOS Film Asset",
  "type":"object",
  "required":["id","uri","duration_seconds","source","captured_at","team_context","status"],
  "properties":{
    "id":{"type":"string","pattern":"^FILM-"},
    "uri":{"type":"string","minLength":1},
    "duration_seconds":{"type":"number","exclusiveMinimum":0},
    "source":{"type":"object","required":["kind","ref"]},
    "captured_at":{"type":"string"},
    "team_context":{"type":"string"},
    "status":{"enum":["registered","ready","rejected"]}
  }
}
