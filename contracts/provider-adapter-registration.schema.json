{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://nfl-fidos.local/contracts/provider-adapter-registration.schema.json",
  "title":"NFL FIDOS Provider Adapter Registration",
  "type":"object",
  "required":["id","organization_id","provider","capabilities","credential_ref","healthcheck_ref","status","external_state_changed","production_implementation_allowed"],
  "properties":{
    "id":{"type":"string","pattern":"^ADAPTER-"},
    "organization_id":{"type":"string","pattern":"^ORG-"},
    "provider":{"type":"object","required":["kind","mode","source_ref"],"properties":{"kind":{"enum":["analytics","performance","calendar","media","source","search"]},"mode":{"const":"read_only"},"source_ref":{"type":"string","pattern":"^(SOURCE|PROVIDER)-"}}},
    "capabilities":{"type":"array","minItems":1,"items":{"enum":["analytics","performance","practice_resources","media","source_refresh","search"]}},
    "credential_ref":{"type":"string","pattern":"^(SECRET|CREDENTIAL)-"},
    "healthcheck_ref":{"type":"string","minLength":1},
    "status":{"enum":["under_review","validated","rejected"]},
    "external_state_changed":{"const":false},
    "production_implementation_allowed":{"const":false},
    "stage_advance_authorized":{"const":false}
  },
  "additionalProperties":true
}
