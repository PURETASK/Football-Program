{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"NFL FIDOS Performance Provider Integration Request",
  "type":"object",
  "required":["organization_id","provider","batch_id","records","source_manifest"],
  "properties":{
    "organization_id":{"type":"string","pattern":"^ORG-"},
    "provider":{"type":"object","required":["kind","mode","source_ref"],"properties":{"kind":{"enum":["wearable_platform","practice_system","performance_platform","approved_export"]},"mode":{"const":"read_only"},"source_ref":{"type":"string"}}},
    "batch_id":{"type":"string","pattern":"^PERF-BATCH-"},
    "records":{"type":"array","maxItems":1000},
    "source_manifest":{"$ref":"performance-ingestion.schema.json"}
  },
  "additionalProperties":true
}
