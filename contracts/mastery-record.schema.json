{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"NFL FIDOS Mastery Record",
  "type":"object",
  "required":["id","learner_id","capability_id","current_level","target_level","evidence","next_actions","review_required"],
  "properties":{
    "id":{"type":"string","pattern":"^MASTERY-"},
    "learner_id":{"type":"string"},
    "capability_id":{"type":"string","pattern":"^CAP-"},
    "current_level":{"type":"string"},
    "target_level":{"type":"string"},
    "evidence":{"type":"array","minItems":1},
    "next_actions":{"type":"array","minItems":1},
    "review_required":{"type":"boolean"}
  }
}
