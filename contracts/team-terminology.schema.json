{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"NFL FIDOS Team Terminology Alias",
  "type":"object",
  "required":["id","organization_id","team_id","alias","normalized_alias","term_id","owner","reason","source_refs","approval_ref","approved_at","status"],
  "properties":{
    "id":{"type":"string","pattern":"^TEAM-ALIAS-"},
    "organization_id":{"type":"string","pattern":"^ORG-"},
    "team_id":{"type":"string","pattern":"^TEAM-"},
    "alias":{"type":"string","minLength":1},
    "normalized_alias":{"type":"string","minLength":1},
    "term_id":{"type":"string","pattern":"^TERM-"},
    "owner":{"type":"string","minLength":1},
    "reason":{"type":"string","minLength":1},
    "source_refs":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "approval_ref":{"type":"string","minLength":1},
    "approved_at":{"type":"string","minLength":1},
    "status":{"enum":["locked","review_required","rejected"]}
  }
}
