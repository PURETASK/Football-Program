{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"NFL FIDOS Organization Terminology Bundle",
  "type":"object",
  "required":["id","organization_id","team_id","season","version","owner","source_refs","approval_ref","aliases","status"],
  "properties":{
    "id":{"type":"string","pattern":"^TERM-BUNDLE-"},
    "organization_id":{"type":"string","pattern":"^ORG-"},
    "team_id":{"type":"string","pattern":"^TEAM-"},
    "season":{"type":"string","minLength":4},
    "version":{"type":"string","minLength":1},
    "owner":{"type":"string","minLength":1},
    "source_refs":{"type":"array","minItems":1,"items":{"type":"string"}},
    "approval_ref":{"type":"string","minLength":1},
    "aliases":{"type":"array","items":{"type":"object"}},
    "status":{"enum":["draft","under_review","approved","rejected","archived"]}
  }
}
