{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"NFL FIDOS Knowledge Claim",
  "type":"object",
  "required":["id","claim","classification","source_refs","context","confidence","uncertainty","status"],
  "properties":{
    "id":{"type":"string","pattern":"^CLAIM-"},
    "claim":{"type":"string","minLength":1},
    "classification":{"enum":["fact","rule","team_rule","observed_tendency","coaching_preference","contextual_principle","hypothesis"]},
    "source_refs":{"type":"array","minItems":1},
    "context":{"type":"object","required":["team","situations"]},
    "confidence":{"enum":["low","moderate","high"]},
    "uncertainty":{"type":"array","minItems":1},
    "status":{"enum":["draft","reviewed","approved","rejected"]}
  }
}
