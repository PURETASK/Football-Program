{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nfl-fidos.local/contracts/organization-drill-validation.schema.json",
  "title": "NFL FIDOS Organization Drill Validation Package",
  "type": "object",
  "required": ["id", "organization_id", "season", "position", "selected_drill_ids", "source_refs", "validator", "status", "human_review_required"],
  "properties": {
    "id": {"type": "string", "pattern": "^ORG-DRILL-VALIDATION-"},
    "organization_id": {"type": "string", "pattern": "^ORG-"},
    "season": {"type": "string", "minLength": 1},
    "position": {"type": "string", "minLength": 1},
    "selected_drill_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "validator": {"type": "string", "minLength": 1},
    "status": {"enum": ["under_review", "validated"]},
    "human_review_required": {"type": "boolean"},
    "owner_decision_ref": {"type": ["string", "null"]},
    "approved_by": {"type": ["string", "null"]},
    "approved_at": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
