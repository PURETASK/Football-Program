{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"NFL FIDOS Callable Agent Record",
  "type":"object",
  "required":["id","name","family","capabilities","permissions","lifecycle","status"],
  "properties":{
    "id":{"type":"string","pattern":"^AGT-"},
    "name":{"type":"string"},
    "family":{"type":"string"},
    "capabilities":{"type":"array","minItems":1},
    "permissions":{"type":"array"},
    "lifecycle":{"enum":["callable","active","deactivated"]},
    "status":{"enum":["registered","invalid"]}
  }
}
