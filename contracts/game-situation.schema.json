{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"NFL FIDOS Game Situation",
  "type":"object",
  "required":["id","quarter","clock_seconds","score_differential","down","distance","timeouts","field_zone","possession","rule_refs"],
  "properties":{
    "id":{"type":"string","pattern":"^SITUATION-"},
    "quarter":{"type":"integer","minimum":1,"maximum":5},
    "clock_seconds":{"type":"integer","minimum":0,"maximum":900},
    "score_differential":{"type":"integer"},
    "down":{"type":"integer","minimum":1,"maximum":4},
    "distance":{"type":"integer","minimum":1},
    "timeouts":{"type":"object"},
    "field_zone":{"type":"string"},
    "possession":{"type":"string"},
    "rule_refs":{"type":"array","minItems":1}
  }
}
