{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"NFL FIDOS Progressive Delivery Wave",
  "type":"object",
  "required":["id","number","outcome","capability_ids","status","blockers","human_approval_required"],
  "properties":{
    "id":{"type":"string","pattern":"^WAVE-"},
    "number":{"type":"integer","minimum":0},
    "outcome":{"type":"string"},
    "capability_ids":{"type":"array","minItems":1},
    "status":{"enum":["planned","blocked","ready","approved"]},
    "blockers":{"type":"array"},
    "human_approval_required":{"type":"boolean"}
  }
}
