{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"NFL FIDOS Performance Support Note",
  "type":"object",
  "required":["id","athlete_context","observations","recommendations","boundaries","escalation_required"],
  "properties":{
    "id":{"type":"string","pattern":"^PERF-"},
    "athlete_context":{"type":"string"},
    "observations":{"type":"array","minItems":1},
    "recommendations":{"type":"array","minItems":1},
    "boundaries":{"type":"array","minItems":1},
    "escalation_required":{"type":"boolean"}
  }
}
