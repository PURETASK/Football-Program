{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"NFL FIDOS Pilot Delivery Package",
  "type":"object",
  "required":["id","organization_id","wave_id","selection_id","readiness_id","rollback","status","live_pilot","production_implementation_allowed"],
  "properties":{
    "id":{"type":"string","pattern":"^PILOT-PKG-"},
    "organization_id":{"type":"string","pattern":"^ORG-"},
    "wave_id":{"type":"string","pattern":"^WAVE-"},
    "selection_id":{"type":"string","pattern":"^PILOT-SEL-"},
    "readiness_id":{"type":"string","minLength":1},
    "rollback":{"type":"object"},
    "status":{"const":"ready_for_bounded_pilot"},
    "live_pilot":{"const":false},
    "production_implementation_allowed":{"const":false},
    "external_state_changed":{"const":false}
  },
  "additionalProperties":true
}
