NFL_FIDOS_ENV=local
NFL_FIDOS_HOST=127.0.0.1
NFL_FIDOS_PORT=8080
NFL_FIDOS_DATABASE=.runtime/nfl_fidos.sqlite3
NFL_FIDOS_FFMPEG=ffmpeg
NFL_FIDOS_FFPROBE=ffprobe
NFL_FIDOS_OBSERVABILITY_PATH=.runtime/observability.jsonl
# Prefer a secret-manager mounted file in production; do not commit secret values.
# NFL_FIDOS_AUTH_SECRET_FILE=/run/secrets/nfl_fidos_auth_secret
# Required for authenticated workflow routes. Use a secret manager in production.
NFL_FIDOS_AUTH_SECRET=replace-with-a-local-development-secret
